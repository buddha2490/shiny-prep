# --- Python / RAG runtime artifacts ------------------------------------------
# The RAG virtualenv is machine-specific; recreate it from rag/requirements.txt.
rag/.venv/

# Byte-compiled Python
__pycache__/
*.pyc

# SQLite write-ahead-log / shared-memory sidecars (runtime only).
# rag/rag.db itself IS tracked — it is the committed knowledge base.
*.db-wal
*.db-shm

# --- macOS --------------------------------------------------------------------
.DS_Store

# --- Claude Code --------------------------------------------------------------
# Machine-local hook activation + permission overrides. The hook SCRIPTS in
# .claude/hooks/ ARE tracked; this file just toggles them on for one machine.
.claude/settings.local.json
.claude/.lint-queue

/.vscode

# --- Scratch work ------------------------------------------------------------
scratch-pad/